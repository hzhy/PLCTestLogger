{
  "_comment": "数据测试用例（工具栏“数据测试”使用，不连接 PLC）。每条用例：name=用例名称；words=PLC 原始字，键为 D 寄存器地址(可写 212 或 D212)，值为 16 位字，可写十进制(0~65535，或 -32768~-1)或十六进制字符串 \"0x41A4\"，没写的地址按 0 处理；32 位数据要写两个地址，本项目高字在前(D212 高 16 位、D213 低 16 位)。expect=期望显示文字，键为寄存器地址(32 位数据写起始地址)，值与实时数据区“内容”列和 Excel 中的文字逐字比对，只检查写出的寄存器。",
  "cases": [
    {
      "name": "压力法，接口结果为浮点",
      "words": {
        "200": 1, "202": 5, "203": 12,
        "204": "0x0000", "205": "0x0001",
        "208": 200, "209": 4, "210": 365, "211": 12,
        "212": "0x41A4", "213": "0x0000",
        "214": "0x41A0", "215": "0xCCCD",
        "234": "0x41A8", "235": "0x0000",
        "240": 1
      },
      "expect": {
        "200": "J0321干式", "202": "4H运转后试验", "203": "12接口", "204": "压力20PsiG",
        "208": "200rpm", "209": "100~200ml", "210": "36.5℃", "211": "12",
        "212": "20.50PsiG", "214": "20.10PsiG", "234": "21.00PsiG", "240": "1"
      }
    },
    {
      "name": "压力法，接口结果为整数（×0.01）",
      "words": {
        "200": 2,
        "204": "0x0000", "205": "0x0002",
        "212": "0x0000", "213": 1450,
        "214": "0x0000", "215": 1995
      },
      "expect": { "200": "J0362干湿式", "204": "压力14.5PsiG", "212": "14.50PsiG", "214": "19.95PsiG" }
    },
    {
      "name": "流量法，接口结果为整数（×0.1）",
      "words": {
        "200": 5, "202": 2, "203": 4,
        "204": "0x0000", "205": "0x000B",
        "212": "0x0000", "213": 4,
        "214": "0x0000", "215": 12,
        "216": "0x0000", "217": 6,
        "218": "0x0000", "219": 5
      },
      "expect": {
        "200": "J0363湿式", "202": "30S运转", "203": "4接口", "204": "流量0.4/2.0ml",
        "212": "0.4ml/min", "214": "1.2ml/min", "216": "0.6ml/min", "218": "0.5ml/min"
      }
    },
    {
      "name": "流量法，接口结果为浮点",
      "words": {
        "204": "0x0000", "205": "0x000C",
        "212": "0x3ECC", "213": "0xCCCD",
        "214": "0x3F66", "215": "0x6666"
      },
      "expect": { "204": "流量0.4/1.0ml", "212": "0.4ml/min", "214": "0.9ml/min" }
    },
    {
      "name": "测试方法以浮点 11.0 写入",
      "words": {
        "204": "0x4130", "205": "0x0000",
        "212": "0x3ECC", "213": "0xCCCD"
      },
      "expect": { "204": "流量0.4/2.0ml", "212": "0.4ml/min" }
    },
    {
      "name": "接口结果为负数（int32 -5）",
      "words": {
        "204": "0x0000", "205": "0x0001",
        "212": "0xFFFF", "213": "0xFFFB"
      },
      "expect": { "212": "-0.05PsiG" }
    },
    {
      "name": "选项表中没有的值显示为 K+数值",
      "words": { "200": 37, "202": 9, "203": 0, "209": 0, "240": 0 },
      "expect": { "200": "K37", "202": "K9", "203": "K0", "209": "无纯水要求", "240": "0" }
    },
    {
      "name": "温度、转速、扭矩数值",
      "words": { "208": 1450, "210": 1005, "211": 30 },
      "expect": { "208": "1450rpm", "210": "100.5℃", "211": "30" }
    }
  ]
}
