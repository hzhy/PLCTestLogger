{
  "_comment": "数据测试用例（工具栏“数据测试”使用，不连接 PLC）。每条用例：name=用例名称；words=PLC 原始字，键为 D 寄存器地址(可写 212 或 D212)，值为 16 位字，可写十进制(0~65535，或 -32768~-1)或十六进制字符串 \"0x41A4\"，没写的地址按 0 处理；32 位数据要写两个地址，本项目低字在前(D212 低 16 位、D213 高 16 位)。expect=期望显示文字，键为寄存器地址(32 位数据写起始地址)，值与实时数据区“内容”列和 Excel 中的文字逐字比对，只检查写出的寄存器。",
  "cases": [
    {
      "name": "压力法，接口结果为浮点",
      "words": {
        "200": 1, "202": 5, "203": 12,
        "204": 1, "205": 0,
        "208": 20000, "209": 4, "210": 365, "211": 1200,
        "212": "0x0000", "213": "0x41A4",
        "214": "0xCCCD", "215": "0x41A0",
        "234": "0x0000", "235": "0x41A8",
        "240": 1
      },
      "expect": {
        "200": "J0321干式", "202": "4H运转后试验", "203": "接口数量12", "204": "压力20PsiG",
        "208": "200.00rpm", "209": "100~200ml", "210": "36.5℃", "211": "12.00N.m",
        "212": "20.50PsiG", "214": "20.10PsiG", "234": "21.00PsiG", "240": "1"
      }
    },
    {
      "name": "压力法，接口结果为整数（×0.001）",
      "words": {
        "200": 2, "204": 2, "205": 0,
        "212": 14500, "213": 0,
        "214": 19950, "215": 0
      },
      "expect": { "200": "J0362干湿式", "204": "压力14.5PsiG", "212": "14.50PsiG", "214": "19.95PsiG" }
    },
    {
      "name": "流量法 0.4/2.0，接口结果为整数（×0.01，2 位小数）",
      "words": {
        "200": 5, "202": 2, "203": 4,
        "204": 11, "205": 0,
        "212": 40, "213": 0,
        "214": 120, "215": 0,
        "216": 60, "217": 0,
        "218": 50, "219": 0
      },
      "expect": {
        "200": "J0363湿式", "202": "30S运转", "203": "接口数量4", "204": "流量0.4/2.0ml",
        "212": "0.40ml/min", "214": "1.20ml/min", "216": "0.60ml/min", "218": "0.50ml/min"
      }
    },
    {
      "name": "流量法 0.4/1.0，接口结果为浮点",
      "words": {
        "204": 12, "205": 0,
        "212": "0xCCCD", "213": "0x3ECC",
        "214": "0x6666", "215": "0x3F66"
      },
      "expect": { "204": "流量0.4/1.0ml", "212": "0.40ml/min", "214": "0.90ml/min" }
    },
    {
      "name": "测试方法以浮点 11.0 写入",
      "words": {
        "204": "0x0000", "205": "0x4130",
        "212": "0xCCCD", "213": "0x3ECC"
      },
      "expect": { "204": "流量0.4/2.0ml", "212": "0.40ml/min" }
    },
    {
      "name": "测试方法不在选项表中，结果按本列倍率（×0.01）、不带单位",
      "words": {
        "204": 21, "205": 0,
        "212": 2050, "213": 0
      },
      "expect": { "204": "K21", "212": "20.50" }
    },
    {
      "name": "接口结果为负数（int32 -50）",
      "words": {
        "204": 1, "205": 0,
        "212": "0xFFCE", "213": "0xFFFF"
      },
      "expect": { "212": "-0.05PsiG" }
    },
    {
      "name": "选项表中没有的值显示为 K+数值",
      "words": { "200": 37, "202": 9, "203": 0, "209": 0, "240": 0 },
      "expect": { "200": "K37", "202": "K9", "203": "K0", "209": "无纯水要求", "240": "0" }
    },
    {
      "name": "温度、转速、扭矩数值",
      "words": { "208": 14500, "210": 1005, "211": 3000 },
      "expect": { "208": "145.00rpm", "210": "100.5℃", "211": "30.00N.m" }
    }
  ]
}
