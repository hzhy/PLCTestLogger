<Window x:Class="PlcTestLogger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PlcTestLogger.App.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="实验数据追溯系统" Height="680" Width="1100" MinHeight="480" MinWidth="800"
        FontSize="13" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="StateCell" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#B00020"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Connected">
                    <Setter Property="Foreground" Value="#1B8A3C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Reconnecting">
                    <Setter Property="Foreground" Value="#C77700"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="新增设备" Click="AddDevice_Click" Padding="8,4"/>
                <Button Content="编辑设备" Click="EditDevice_Click" Padding="8,4" ToolTip="修改选中设备的 IP、端口等（需先停用；设备编号不可改）"/>
                <Button Content="删除设备" Command="{Binding RemoveDeviceCommand}" Padding="8,4"/>
                <Separator/>
                <Button Content="查询记录" Click="Search_Click" Padding="8,4"/>
                <Button Content="打开记录文件夹" Command="{Binding OpenLoggerDirCommand}" Padding="8,4"/>
                <Separator/>
                <TextBlock Text="{Binding TriggerInfo}" VerticalAlignment="Center" Margin="8,0" Foreground="#555"/>
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding LoggerDir, StringFormat=记录目录：{0}}"/>
            <Separator/>
            <TextBlock Text="{Binding RegisterSource, StringFormat=寄存器定义：{0}}"/>
        </StatusBar>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="140"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Header="设备列表" Grid.Column="0">
                    <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MouseDoubleClick="DeviceGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="启用" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="打开后才会轮询 PLC 并保存记录"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="设备编号" Binding="{Binding Id}" Width="110"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120"/>
                            <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="55"/>
                            <DataGridTemplateColumn Header="连接状态" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource StateCell}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="本次运行保存" Binding="{Binding SavedCount}" Width="95"/>
                            <DataGridTextColumn Header="最近保存时间" Binding="{Binding LastSavedAt}" Width="140"/>
                            <DataGridTextColumn Header="最近错误" Binding="{Binding LastError}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
                <GroupBox Grid.Column="2">
                    <GroupBox.Header>
                        <TextBlock Text="{Binding SelectedDevice.Id, StringFormat=实时数据：{0}, FallbackValue=实时数据}"/>
                    </GroupBox.Header>
                    <DataGrid ItemsSource="{Binding Registers}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="寄存器" Binding="{Binding Register}" Width="65"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="130"/>
                            <DataGridTextColumn Header="原始值" Binding="{Binding Raw}" Width="115"/>
                            <DataGridTextColumn Header="内容" Binding="{Binding Text}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent"/>
            <GroupBox Header="事件" Grid.Row="2">
                <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12"/>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
