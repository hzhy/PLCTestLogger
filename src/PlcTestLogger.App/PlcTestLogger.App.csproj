<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PlcTestLogger.Core\PlcTestLogger.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PlcLogger</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>实验数据追溯系统</Product>
    <AssemblyTitle>实验数据追溯系统</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <None Include="config\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
