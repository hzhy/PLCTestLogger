<Window x:Class="PlcTestLogger.App.Views.DataTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据测试" Height="600" Width="1150" MinHeight="300" MinWidth="700"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="测试文件" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Right" Content="运行测试" Command="{Binding RunCommand}" Padding="14,3" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="选择文件…" Click="Browse_Click" Padding="8,3" Margin="8,0,0,0"/>
            <CheckBox DockPanel.Dock="Right" Content="只看失败" IsChecked="{Binding OnlyFailures}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBox Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" Padding="4,3"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#666" TextWrapping="Wrap"
                   Text="按测试文件中的 PLC 原始字，用当前寄存器定义换算。实际值＝原始字按数据类型和字序解码后的数值（未乘倍率、未查选项）；显示值＝语义化后的文字，与期望逐字比对。不连接 PLC，不写 Excel。"/>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0" FontWeight="Bold" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#1B8A3C"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBad}" Value="True">
                            <Setter Property="Foreground" Value="#B00020"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Passed}" Value="False">
                            <Setter Property="Background" Value="#FDECEC"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="用例" Binding="{Binding Case}" Width="200"/>
                <DataGridTextColumn Header="寄存器" Binding="{Binding Register}" Width="60"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="110"/>
                <DataGridTextColumn Header="原始字" Binding="{Binding Raw}" Width="110"/>
                <DataGridTextColumn Header="实际值" Binding="{Binding Value}" Width="120"/>
                <DataGridTextColumn Header="显示值" Binding="{Binding Display}" Width="*"/>
                <DataGridTextColumn Header="期望" Binding="{Binding Expected}" Width="140"/>
                <DataGridTemplateColumn Header="结果" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ResultText}" FontWeight="Bold" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1B8A3C"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Passed}" Value="False">
                                                <Setter Property="Foreground" Value="#B00020"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
